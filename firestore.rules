rules_version = '2';

// Luật bảo mật Firestore cho 3BichCoffee.
// Áp dụng: Firebase Console -> Firestore Database -> Rules -> dán toàn bộ file này -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Tài khoản admin (tạo ở Firebase Console -> Authentication -> Users).
    // Thêm/bớt admin thì sửa danh sách email này rồi Publish lại.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'vanduoc@3bichcoffee.com',
          'ngocbich@3bichcoffee.com'
        ];
    }

    // Menu, danh mục, thông tin giới thiệu: khách xem, chỉ admin sửa
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Thống kê truy cập: trình duyệt khách chỉ được tạo phiên mới và cập nhật thời gian ở lại;
    // chỉ admin được xem / xoá
    match /visitor_sessions/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                         ['ip', 'device', 'browser', 'startTime', 'date', 'duration', 'userAgent'])
                    && request.resource.data.startTime == request.time
                    && request.resource.data.duration == 0
                    && request.resource.data.ip is string && request.resource.data.ip.size() <= 64
                    && request.resource.data.device is string && request.resource.data.device.size() <= 20
                    && request.resource.data.browser is string && request.resource.data.browser.size() <= 20
                    && request.resource.data.date is string && request.resource.data.date.size() <= 10
                    && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['duration', 'lastActive', 'endTime'])
                    && request.resource.data.duration is int
                    && request.resource.data.duration >= 0
                    && request.resource.data.duration <= 604800;
    }

    // Nhật ký đăng nhập admin
    match /SessionLogin/{id} {
      allow read, create: if isAdmin();
    }

    // Mọi collection khác (kể cả "users" cũ chứa mật khẩu) bị khoá mặc định.
  }
}
